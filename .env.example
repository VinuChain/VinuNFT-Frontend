# Every GATSBY_-prefixed value is compiled into the public browser bundle and is
# readable by anyone who loads the site. Do not put a secret here; restrict these
# keys by domain at the provider instead.
# Used only for ENS reverse lookups on Ethereum mainnet. Left empty, ethers 5
# falls back to its shared public demo key, which is rate limited to the point
# where ENS names stop resolving under any real traffic.
GATSBY_ALCHEMY_MAINNET_API_KEY=
GATSBY_IPFS_UPLOAD_ENDPOINT=/api/upload-ipfs

# Server-side only. Never prefix this with GATSBY_.
PINATA_API_JWT=
# Allowlist-only image upload MVP. Public uploads require durable rate limiting first.
PINATA_ALLOWED_UPLOAD_ADDRESSES=
PINATA_MAX_UPLOAD_BYTES=10485760
PINATA_MAX_UPLOADS_PER_WINDOW=20
PINATA_MAX_GLOBAL_UPLOADS_PER_WINDOW=200
# Durable rate-limit store (Upstash Redis REST, or any Redis-compatible REST
# endpoint that answers /pipeline). REQUIRED in every Vercel deployment,
# preview included: without it the upload endpoint refuses every upload rather
# than falling back to a per-instance counter that is no limit at all. Left
# empty outside a deployment, uploads use the local-development in-memory
# counter instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Keep well under the serverless function duration limit. A store that cannot
# answer within this refuses the upload.
UPLOAD_RATE_LIMIT_TIMEOUT_MS=2000
TRUSTED_CLIENT_IP_HEADER=
# Chain the upload intent signature is bound to (VinuChain mainnet).
UPLOAD_CHAIN_ID=207
# Accepted image media types for IPFS upload (SVG is excluded: script bearing).
PINATA_ALLOWED_MEDIA_TYPES=image/png,image/jpeg,image/gif,image/webp
# Reject images whose declared geometry exceeds this pixel count.
PINATA_MAX_IMAGE_PIXELS=40000000
